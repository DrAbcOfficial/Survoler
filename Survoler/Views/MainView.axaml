<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Survoler.ViewModels"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="Survoler.Views.MainView"
              x:DataType="vm:MainViewModel">
    <Grid Background="#F2EFE7" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#152B2A" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="SURVOLER"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#A9D9CF"
                               LetterSpacing="3" />
                    <TextBlock Text="{Binding FileName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        IsVisible="{Binding IsLegacy}"
                        Background="#D6A84B"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="COMPATIBILITY"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#272116" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <NativeWebView x:Name="PreviewWebView"
                           IsVisible="{Binding HasPreview}"
                           Background="#F2EFE7" />

            <Border IsVisible="{Binding IsStatusVisible}"
                    Margin="24">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Spacing="16">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="17"
                               Foreground="#263533"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar IsVisible="{Binding IsLoading}"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding LoadProgress}"
                                 Width="260"
                                 Height="5" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
