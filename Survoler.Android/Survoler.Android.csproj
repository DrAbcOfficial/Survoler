<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ApplicationId>net.drabc.survoler</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Survoler\Survoler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="..\Survoler\Assets\icon.png"
                     Link="Resources\mipmap\survoler_icon.png" />
    <AndroidResource Include="..\Survoler\Assets\icon_trans.png"
                     Link="Resources\drawable-nodpi\survoler_icon_foreground_source.png" />
  </ItemGroup>
</Project>
